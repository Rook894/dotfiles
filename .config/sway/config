# Default config for sway
#
# Copy this to ~/.config/sway/config and edit it to your liking.
#
# Read `man 5 sway` for a complete reference.

### Variables
#
# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l
# Your preferred terminal emulator
# Recommends: foot
set $term alacritty
# Your preferred application launcher
# Note: pass the final command to swaymsg so that the resulting window can be opened
# on the original workspace that the command was run on.
# Recommends: rofi-wayland
set $rofi_cmd rofi \
        -terminal '$term'
# Shows a combined list of the applications with desktop files and
# executables from PATH.
# TODO: add window with the next release of rofi-wayland
set $menu $rofi_cmd -show combi -combi-modes drun#run -modes combi

### Output configuration
#
# Default wallpaper (more resolutions are available in /usr/share/backgrounds/sway/)
# Requires: desktop-backgrounds-compat, swaybg, jxl-pixbuf-loader
output * bg /usr/share/backgrounds/default.jxl fill
#
# Example configuration:
#
#   output HDMI-A-1 resolution 1920x1080 position 1920,0
#
# You can get the names of your outputs by running: swaymsg -t get_outputs

### Idle configuration

exec swayidle -w \
    timeout 300 'swaylock -f -c 000000' \
    timeout 600 'swaymsg "output * dpms off"' resume 'swaymsg "output * dpms on"' \
    before-sleep 'swaylock -f -c 000000'

# After 300 seconds (5 minutes) lock screen with a solid black background (-c 000000)
# After 600 seconds (10 minutes) turns off the display and unlocks it if it detects activity.
# before-sleep makes sure the screen is locked before system goes to sleep

### Input configuration
#
# Example configuration:
#
#   input "2:14:SynPS/2_Synaptics_TouchPad" {
#       dwt enabled
#       tap enabled
#       natural_scroll enabled
#       middle_emulation enabled
#   }
#
# You can get the names of your inputs by running: swaymsg -t get_inputs
# Read `man 5 sway-input` for more information about this section.
input "type:keyboard" {
    xkb_layout us,ru
    xkb_options grp:shifts_toggle
}

# Trackpoint
input "2:10:TPPS/2_IBM_TrackPoint" {
    accel_profile adaptive
    pointer_accel 0.3
}

# Touchscreen
input "9094:13070:Raydium_Corporation_Raydium_Touch_System" {
    events disabled
}

# Touchpad
input "1739:0:Synaptics_TM3276-022" {
    events disabled
}

### Appearance
# Borders:
# normal - includes border and title bar
# pixel n = includes n pixel border, but no title bar
# none - no border, no title bar
default_border pixel 1
default_floating_border pixel 1

# Hide borders and gaps when there's only one window
smart_borders no_gaps

# Dark theme
# Install adw-gtk3-theme from dnf
exec_always {
    gsettings set org.gnome.desktop.interface gtk-theme 'adw-gtk3-dark'
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
}

# Waybar
# Waybar is launched using systemd
# systemctl --user enable --now waybar.service
exec_always systemctl --user restart waybar.service


### Window rules
# Use
# swaymsg -t get_tree
# to get a list of windows

for_window [app_id="qalculate-gtk"] floating enable
for_window [app_id="thunar" title="File Operation Progress"] floating enable, resize set 500 200, move position 20 20
for_window [app_id="firefox" title="Picture-in-Picture"] floating enable, sticky enable

### Key bindings
#
# Ignore layout, resolving by physical key position
set $bind bindsym --to-code

# Start programs:
$bind $mod+b exec firefox
$bind $mod+Shift+b exec firefox --private-window

# Utilities:
$bind $mod+Shift+x exec grimpicker -cd
$bind $mod+Shift+s exec grimshot copy area
$bind Shift+Print exec grimshot copy screen

# Lock screen
$bind $mod+Escape exec swaylock -f -c 000000


# Media button:
#
# Media buttons
set $mediaPositionStep 5

    $bind $mod+Left exec playerctl previous
    $bind $mod+Shift+Left exec playerctl position $mediaPositionStep-
    $bind $mod+Down exec playerctl play-pause
    $bind $mod+Right exec playerctl next 
    $bind $mod+Shift+Right exec playerctl position $mediaPositionStep+

# Basics:
#
    # Start a terminal
    $bind $mod+Return exec $term

    # Kill focused window
    $bind $mod+Shift+q kill

    # Start your launcher
    $bind $mod+d exec $menu

    # Drag floating windows by holding down $mod and left mouse button.
    # Resize them with right mouse button + $mod.
    # Despite the name, also works for non-floating windows.
    # Change normal to inverse to use left mouse button for resizing and right
    # mouse button for dragging.
    floating_modifier $mod normal

    # Reload the configuration file
    $bind $mod+Shift+c reload

    # Exit sway (logs you out of your Wayland session)
    $bind $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'
#
# Moving around:
#
    # Move your focus around
    $bind $mod+$left focus left
    $bind $mod+$down focus down
    $bind $mod+$up focus up
    $bind $mod+$right focus right
    # Or use $mod+[up|down|left|right] (Don't)
    # $bind $mod+Left focus left
    # $bind $mod+Down focus down
    # $bind $mod+Up focus up
    # $bind $mod+Right focus right

    # Move the focused window with the same, but add Shift
    $bind $mod+Shift+$left move left
    $bind $mod+Shift+$down move down
    $bind $mod+Shift+$up move up
    $bind $mod+Shift+$right move right
    # Ditto, with arrow keys (Don't)
    # $bind $mod+Shift+Left move left
    # $bind $mod+Shift+Down move down
    # $bind $mod+Shift+Up move up
    # $bind $mod+Shift+Right move right

    # Resize the focused window
    $bind $mod+Ctrl+h resize grow width 20px
    $bind $mod+Ctrl+l resize shrink width 20px
    $bind $mod+Ctrl+k resize shrink height 20px
    $bind $mod+Ctrl+j resize grow height 20px
#
# Workspaces:
#
    # Switch to workspace
    $bind $mod+1 workspace number 1
    $bind $mod+2 workspace number 2
    $bind $mod+3 workspace number 3
    $bind $mod+4 workspace number 4
    $bind $mod+5 workspace number 5
    $bind $mod+6 workspace number 6
    $bind $mod+7 workspace number 7
    $bind $mod+8 workspace number 8
    $bind $mod+9 workspace number 9
    $bind $mod+0 workspace number 10
    # Move focused container to workspace
    $bind $mod+Shift+1 move container to workspace number 1
    $bind $mod+Shift+2 move container to workspace number 2
    $bind $mod+Shift+3 move container to workspace number 3
    $bind $mod+Shift+4 move container to workspace number 4
    $bind $mod+Shift+5 move container to workspace number 5
    $bind $mod+Shift+6 move container to workspace number 6
    $bind $mod+Shift+7 move container to workspace number 7
    $bind $mod+Shift+8 move container to workspace number 8
    $bind $mod+Shift+9 move container to workspace number 9
    $bind $mod+Shift+0 move container to workspace number 10
    # Note: workspaces can have any name you want, not just numbers.
    # We just use 1-10 as the default.
#
# Layout stuff:
#
    # You can "split" the current object of your focus with
    # $mod+b or $mod+v, for horizontal and vertical splits
    # respectively.
    $bind $mod+c splith
    $bind $mod+v splitv

    # Switch the current container between different layout styles
    $bind $mod+s layout stacking
    $bind $mod+w layout tabbed
    $bind $mod+e layout toggle split

    # Make the current focus fullscreen
    $bind $mod+f fullscreen

    # Toggle the current focus between tiling and floating mode
    $bind $mod+Shift+space floating toggle

    # Swap focus between the tiling area and the floating area
    $bind $mod+space focus mode_toggle

    # Move focus to the parent container
    $bind $mod+a focus parent
#
# Scratchpad:
#
    # Sway has a "scratchpad", which is a bag of holding for windows.
    # You can send windows there and get them back later.

    # Move the currently focused window to the scratchpad
    $bind $mod+Shift+minus move scratchpad

    # Show the next scratchpad window or hide the focused scratchpad window.
    # If there are multiple scratchpad windows, this command cycles through them.
    $bind $mod+minus scratchpad show
#
# Resizing containers:
#
mode "resize" {
    # left will shrink the containers width
    # right will grow the containers width
    # up will shrink the containers height
    # down will grow the containers height
    $bind $left resize shrink width 10px
    $bind $down resize grow height 10px
    $bind $up resize shrink height 10px
    $bind $right resize grow width 10px

    # Ditto, with arrow keys
    $bind Left resize shrink width 10px
    $bind Down resize grow height 10px
    $bind Up resize shrink height 10px
    $bind Right resize grow width 10px

    # Return to default mode
    $bind Return mode "default"
    $bind Escape mode "default"
}
$bind $mod+r mode "resize"

# Include configs from 3 locations:
#  - /usr/share/sway/config.d
#  - /etc/sway/config.d
#  - $XDG_CONFIG_HOME/sway/config.d ($HOME/.config/sway/config.d)
#
# If multiple directories contain the files with the same name, the later
# directory takes precedence; `$XDG_CONFIG_HOME/sway/config.d/20-swayidle.conf`
# will always be loaded instead of `/usr/share/sway/config.d/20-swayidle.conf`
# or `/etc/sway/config.d/20-swayidle.conf`
#
# This mechanism permits overriding our default configuration per-system
# (/etc) or per-user ($XDG_CONFIG_HOME) basis. Just create the file you
# want to modify/override in the higher-level directory.
#
# For example, to disable the default bar from Fedora configs, you'll need to
#     $ echo -n > "$HOME/.config/sway/config.d/90-bar.conf"
#
# Note the quoting, the $() and the arguments quoting. All the parts are equally
# important to make the magic work. And if you want to learn the secret behind
# the trick, it's all in the `wordexp(3)`.
#
include '$(/usr/libexec/sway/layered-include "/usr/share/sway/config.d/*.conf" "/etc/sway/config.d/*.conf" "${XDG_CONFIG_HOME:-$HOME/.config}/sway/config.d/*.conf")'